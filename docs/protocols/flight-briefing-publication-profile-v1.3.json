{
  "protocol_version": "1.3.0",
  "effective_date": "2026-08-08",
  "product_name": "Flight Briefing",
  "legacy_repository_name_allowed": true,
  "foundational_principle": "Flight Briefing computes and never guesses. Helpyou retrieves and never invents. PilotDriven presents and the pilot decides.",
  "report": {
    "mode": "combined",
    "filename_pattern": "^[A-Z0-9]+_[0-9]{2}[A-Z]{3}[0-9]{4}_Flight_Briefing\\.pdf$",
    "primary_download_only": true,
    "full_cfp_appended": false,
    "full_cfp_embedded": false,
    "full_cfp_attached": false,
    "prohibited_user_facing_terms": [
      "Level 1",
      "Level 2",
      "Pertinent Brief",
      "Pertinent Briefing",
      "Evidence Level",
      "Evidence Brief"
    ]
  },
  "page_1": {
    "information_side": "left",
    "map_side": "right",
    "airport_card_roles": [
      "departure",
      "destination",
      "alternate"
    ],
    "airport_cards_equal_geometry": true,
    "airport_cards_consistent_alignment": true,
    "preferred_alternate_weather_required": true,
    "critical_cfp_items_required": [
      "flight_identity",
      "route_and_runway",
      "schedule_and_block_time",
      "aircraft_type_and_registration",
      "distance_and_cruise_component",
      "burnoff_and_statistical_contingency",
      "preferred_alternate_and_holding_fuel",
      "taxi_fuel",
      "planned_masses",
      "flight_plan_requirement",
      "fuel_in_tanks",
      "excess_fuel_and_allocation",
      "destination_and_edto_topups",
      "mel_cdl_cddl",
      "flow_allocation_when_present"
    ]
  },
  "typography": {
    "detail_font_scale_minimum": 1.2,
    "minimum_detail_font_pt": 8.4,
    "minimum_numeric_font_pt": 8.4,
    "table_cell_vertical_alignment": "middle",
    "card_text_vertical_alignment": "middle",
    "row_height_policy": "content-aware",
    "cell_padding_policy": "balanced",
    "text_overflow_policy": "fail"
  },
  "logo": {
    "approved_mark_family": "forward-flight",
    "x_mark_prohibited": true,
    "asset_hash_required": true
  },
  "decision_gates": {
    "internal_hyperlink_required": true,
    "target_must_exist": true,
    "applicable_categories": [
      "BOBCAT",
      "EDTO",
      "MEL/CDL",
      "TERRAIN/DEPRESS",
      "SIGMET/HAZARDS",
      "AIRPORTS",
      "PERFORMANCE/FUEL",
      "FIR/COMMUNICATIONS"
    ],
    "prohibited_label": "TECH"
  },
  "source_crops": {
    "required_when_applicable": [
      "MEL/CDL",
      "EDTO",
      "DEPRESSURISATION"
    ],
    "required_fields": [
      "category",
      "source_document",
      "source_revision_or_effective_date",
      "source_reference",
      "source_page",
      "crop_box",
      "embedded",
      "link_target"
    ],
    "matched_profile_requires_cropped_chart": true,
    "generic_profile_substitution": false
  },
  "high_terrain_exposure": {
    "trigger": "MSA strictly greater than 100*",
    "exactly_100_star_qualifies": false,
    "break_condition": "first waypoint at or below 100*",
    "isolated_events_remain_separate": true,
    "continuous_mountain_interpolation": false
  },
  "hazard_assessment": {
    "mandatory_for_every_cfp": true,
    "product_classes": [
      "SIGMET",
      "TROPICAL_CYCLONE",
      "VOLCANIC_ASH",
      "FRONTAL_WEATHER",
      "CLEAR_AIR_TURBULENCE"
    ],
    "required_finding_fields": [
      "product_type",
      "issuer",
      "issue_time_utc",
      "valid_from_utc",
      "valid_to_utc",
      "phenomenon",
      "observation_status",
      "intensity",
      "position",
      "vertical_extent",
      "movement",
      "trend",
      "route_relationship",
      "time_relationship",
      "level_relationship",
      "operational_consequence",
      "classification",
      "reason_codes",
      "source_id"
    ],
    "classifications": [
      "SIGNIFICANT",
      "RELEVANT",
      "MONITOR",
      "NOT_PROMOTED",
      "COVERAGE_GAP"
    ],
    "coverage_gap_is_nil": false,
    "lay_language_prohibited": true
  },
  "deduplication": {
    "one_primary_location_per_fact": true,
    "supporting_locations_may_link_not_repeat": true,
    "allowed_repeated_orientation_fields": [
      "flight_number",
      "route",
      "date",
      "aircraft_type",
      "registration",
      "page_number"
    ]
  },
  "release_checks": [
    "filename",
    "prohibited_terminology",
    "full_cfp_exclusion",
    "page1_scan_path",
    "airport_card_geometry",
    "typography",
    "logo",
    "decision_gate_links",
    "mel_cdl_label",
    "source_crops",
    "depressurisation_chart_embedding",
    "fact_deduplication",
    "hazard_completeness",
    "coverage_gap_integrity",
    "text_overlap",
    "text_clipping",
    "source_link_integrity",
    "visual_preflight"
  ]
}
