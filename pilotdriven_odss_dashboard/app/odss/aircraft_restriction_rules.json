  "restrictionForms": [
    {
      "id": "unavailable_to_code_class",
      "kind": "aerodrome_code",
      "semantics": "prohibited_code_class",
      "pattern": "\\b(?:CLSD|CLOSED|NOT\\s+AVBL|NOT\\s+AVAILABLE|NOT\\s+PERMITTED|PROHIBITED)\\s+(?:TO|FOR)\\s+(?:ALL\\s+)?(?:(?:ACFT|AIRCRAFT|AEROPLANES?|AIRPLANES?)\\s+)?(?:(?:WITH|OF)\\s+)?(?:(?:AERODROME|ICAO|EASA)\\s+)?(?:REF(?:ERENCE)?\\s+)?CODE(?:\\s+LETTER)?\\s+'?([A-F])'?(?![A-Z0-9])(?:\\s+(?:ACFT|AIRCRAFT|AEROPLANES?|AIRPLANES?))?(?:\\s+(?:AND|OR)\\s+(ABV|ABOVE|HIGHER|LARGER|BLW|BELOW|SMALLER|LOWER))?",
      "groups": {
        "code": 1,
        "direction": 2
      },
      "readFrom": "Generic ICAO NOTAM wording; cf. the WSSS training sample \"TWY SA CLSD FOR ACFT CODE E AND BELOW\""
    },
    {
      "id": "unavailable_above_wingspan",
      "kind": "wingspan",
      "semantics": "prohibited_wingspan_class",
      "pattern": "\\b(?:CLSD|CLOSED|NOT\\s+AVBL|NOT\\s+AVAILABLE|NOT\\s+PERMITTED|PROHIBITED)\\s+(?:TO|FOR)\\s+(?:ALL\\s+)?(?:ACFT|AIRCRAFT|AEROPLANES?|AIRPLANES?)\\s+(?:WITH\\s+)?(?:A\\s+)?(?:WINGSPAN|WING\\s+SPAN)\\s+(?:OF\\s+)?(MORE\\s+THAN|GREATER\\s+THAN|LARGER\\s+THAN|EXCEEDING|ABOVE|OVER)\\s+(\\d{1,3}(?:\\.\\d+)?)\\s*(M|FT)(?![A-Z0-9])",
      "groups": {
        "comparator": 1,
        "value": 2,
        "unit": 3
      },
      "inclusive": false,
      "readFrom": "KLAX 1A4372/26 \"TWY B BTN TWY B3 AND TWY B1 CLSD TO ACFT WINGSPAN MORE THAN 118FT\""
    },
    {
      "id": "downgraded_to_code",
      "kind": "aerodrome_code",
      "semantics": "maximum_code",
      "pattern": "\\b(?:DOWNGRADED|DOWNGRADE|DOWNGRADING|REDUCED)\\s+TO\\s+(?:(?:AERODROME|ICAO|EASA)\\s+)?(?:REF(?:ERENCE)?\\s+)?CODE(?:\\s+LETTER)?\\s+'?([A-F])'?(?![A-Z0-9])",
      "groups": {
        "code": 1
      },
      "readFrom": "VHHH 1A1868/26 \"TWY E BTN TWY F5 AND TWY F6 DOWNGRADED TO CODE E DUE WIP\""
    },
    {
      "id": "downgrade_of_subject_to_code",
      "kind": "aerodrome_code",
      "semantics": "maximum_code",
      "pattern": "\\b(?:DOWNGRADE|DOWNGRADING|DOWNGRADED|REDUCTION)\\s+(?:OF|FOR)\\s+([^.;\\n]{1,60}?)\\s+TO\\s+(?:(?:AERODROME|ICAO|EASA)\\s+)?(?:REF(?:ERENCE)?\\s+)?CODE(?:\\s+LETTER)?\\s+'?([A-F])'?(?![A-Z0-9])",
      "groups": {
        "subject": 1,
        "code": 2
      },
      "readFrom": "WSSS SX93/26 \"DOWNGRADE OF AIRCRAFT STAND 603 TO CODE C\""
    },
    {
      "id": "limited_to_max_code",
      "kind": "aerodrome_code",
      "semantics": "maximum_code",
      "pattern": "\\b(?:RESTRICTED|LIMITED|LTD)\\s+TO\\s+(?:A\\s+)?MAX(?:IMUM)?\\s+(?:OF\\s+)?(?:(?:ACFT|AIRCRAFT|AEROPLANES?|AIRPLANES?)\\s+)?(?:TYPE\\s+)?(?:(?:AERODROME|ICAO|EASA)\\s+)?(?:REF(?:ERENCE)?\\s+)?CODE(?:\\s+LETTER)?\\s+'?([A-F])'?(?![A-Z0-9])",
      "groups": {
        "code": 1
      },
      "readFrom": "EBBR 1A2446/26 \"TWY INN-6 RESTRICTED TO MAX ACFT TYPE CODE E\"; EDDF 1A3671/26 \"TWY L20 LTD TO MAX ACFT TYPE CODE C\""
    },
    {
      "id": "up_to_code",
      "kind": "aerodrome_code",
      "semantics": "maximum_code",
      "pattern": "\\b(?:UP\\s*TO|UPTO)\\s+(?:AND\\s+INCLUDING\\s+)?(?:(?:ACFT|AIRCRAFT|AEROPLANES?|AIRPLANES?)\\s+)?(?:(?:AERODROME|ICAO|EASA)\\s+)?(?:REF(?:ERENCE)?\\s+)?CODE(?:\\s+LETTER)?\\s+'?([A-F])'?(?![A-Z0-9])",
      "groups": {
        "code": 1
      },
      "readFrom": "VECC 1A852/26 \"RWY 19R/01L AVBL FOR OPS UPTO CODE C ACFT ONLY\"; VVDN SX12/26 \"STAND 18 USED FOR AIRCRAFT UP TO CODE C\""
    },
    {
      "id": "limited_of_subject_to_code",
      "kind": "aerodrome_code",
      "semantics": "code_only",
      "pattern": "\\b(?:LIMITATION|RESTRICTION)\\s+(?:OF|FOR)\\s+([^.;\\n]{1,60}?)\\s+TO\\s+(?:(?:AERODROME|ICAO|EASA)\\s+)?(?:REF(?:ERENCE)?\\s+)?CODE(?:\\s+LETTER)?\\s+'?([A-F])'?(?![A-Z0-9])",
      "groups": {
        "subject": 1,
        "code": 2
      },
      "readFrom": "Same sentence shape as WSSS SX93/26 with a limiting noun; the notice names one letter only"
    },
    {
      "id": "limited_to_code",
      "kind": "aerodrome_code",
      "semantics": "code_only",
      "pattern": "\\b(?:RESTRICTED|LIMITED|LTD)\\s+TO\\s+(?:(?:ACFT|AIRCRAFT|AEROPLANES?|AIRPLANES?)\\s+)?(?:TYPE\\s+)?(?:(?:AERODROME|ICAO|EASA)\\s+)?(?:REF(?:ERENCE)?\\s+)?CODE(?:\\s+LETTER)?\\s+'?([A-F])'?(?![A-Z0-9])",
      "groups": {
        "code": 1
      },
      "readFrom": "EBBR 1A2448/26 \"TWY A5 RESTRICTED TO ACFT CODE E\""
    },
    {
      "id": "code_only",
      "kind": "aerodrome_code",
      "semantics": "code_only",
      "pattern": "\\b(?:(?:AERODROME|ICAO|EASA)\\s+)?(?:REF(?:ERENCE)?\\s+)?CODE(?:\\s+LETTER)?\\s+'?([A-F])'?(?![A-Z0-9])\\s+(?:(?:ACFT|AIRCRAFT|AEROPLANES?|AIRPLANES?)\\s+)?ONLY(?![A-Z0-9])",
      "groups": {
        "code": 1
      },
      "readFrom": "VVDN SX12/26 \"STAND 14 ONLY USED FOR AIRCRAFT CODE C\"; generic \"CODE C ACFT ONLY\""
    },
    {
      "id": "max_wingspan",
      "kind": "wingspan",
      "semantics": "maximum_wingspan",
      "pattern": "\\bMAX(?:IMUM)?\\s+(?:WINGSPAN|WING\\s+SPAN)\\s+(?:OF\\s+)?(\\d{1,3}(?:\\.\\d+)?)\\s*(M|FT)(?![A-Z0-9])",
      "groups": {
        "value": 1,
        "unit": 2
      },
      "inclusive": true,
      "readFrom": "Generic \"MAX WINGSPAN 36M\" stand and taxilane limits"
    },
    {
      "id": "wingspan_smaller_than",
      "kind": "wingspan",
      "semantics": "maximum_wingspan",
      "pattern": "\\b(?:WINGSPAN|WING\\s+SPAN)\\s+(?:SMALLER|LESS|LOWER)\\s+THAN\\s+(\\d{1,3}(?:\\.\\d+)?)\\s*(M|FT)(?![A-Z0-9])",
      "groups": {
        "value": 1,
        "unit": 2
      },
      "inclusive": false,
      "readFrom": "EBBR 1A2098/26 \"RESTRICTED TO ACFT WITH WINGSPAN SMALLER THAN 68.6M\""
    }
  ],
  "readingGuards": [
    {
      "id": "negated",
      "where": "sentence_before",
      "label": "the limit is negated",
      "pattern": "\\b(?:NOT|NO|NEVER|NIL|WITHOUT)\\b"
    },
    {
      "id": "reversed",
      "where": "clause",
      "label": "the limit may be cancelled, lifted or suspended",
      "pattern": "\\b(?:CANCELLED|CANCELED|CNL|CNLD|WITHDRAWN|REVOKED|RESCINDED|LIFTED|REMOVED|SUSPENDED|NO\\s+LONGER|RESTORED|RETURNED\\s+TO\\s+NORMAL)\\b"
    },
    {
      "id": "list_before",
      "where": "before",
      "label": "it names more than one code letter or a range",
      "pattern": "\\bCODE\\s+(?:LETTER\\s+)?'?[A-F]'?\\s*(?:(?:ACFT|AIRCRAFT|AEROPLANES?|AIRPLANES?)\\s+)?(?:,|/|-|&|\\bAND\\b|\\bOR\\b|\\bTO\\b)\\s*(?:(?:ACFT|AIRCRAFT|AEROPLANES?|AIRPLANES?)\\s+)?$"
    },
    {
      "id": "list_after",
      "where": "after",
      "label": "it names more than one code letter or a range",
      "pattern": "^\\s*(?:,|/|-|&|\\+|\\bAND\\b|\\bOR\\b|\\bTO\\b|\\bTHRU\\b|\\bTHROUGH\\b)\\s*(?:(?:ACFT|AIRCRAFT|AEROPLANES?|AIRPLANES?)\\s+)?(?:CODE\\s+)?(?:LETTER\\s+)?'?[A-F]'?(?![A-Z0-9])"
    },
    {
      "id": "direction_after",
      "where": "after",
      "label": "it adds \"and above/below\" wording the rules do not read here",
      "pattern": "^\\s*(?:(?:ACFT|AIRCRAFT|AEROPLANES?|AIRPLANES?)\\s+)?(?:AND|OR)\\s+(?:ABV|ABOVE|HIGHER|LARGER|GREATER|BLW|BELOW|SMALLER|LOWER|LESS)\\b"
    },
    {
      "id": "size_list_after",
      "where": "after",
      "label": "it states more than one size or a range",
      "pattern": "^\\s*(?:,|/|-|\\bAND\\b|\\bOR\\b|\\bTO\\b)\\s*\\d"
    }
  ],
  "conditionMarkers": [
    {
      "id": "day_or_night",
      "label": "day/night condition",
      "pattern": "\\b(?:DAY|NIGHT)\\s+ONLY\\b|\\b(?:DURING|BY)\\s+(?:DAY|NIGHT)\\b|\\bHJ\\b|\\bHN\\b"
    },
    {
      "id": "towing",
      "label": "towing condition",
      "pattern": "\\bTOW(?:ING|ED)?\\b|\\bUNDER\\s+TOW\\b"
    },
    {
      "id": "guidance",
      "label": "follow-me or marshalling condition",
      "pattern": "\\bFOLLOW[- ]?ME\\b|\\bMARSHALL?(?:ER|ERS|ING)\\b|\\bWING\\s*WALKERS?\\b"
    },
    {
      "id": "exception",
      "label": "stated exception",
      "pattern": "\\bEXC\\b|\\bEXCEPT\\b|\\bEXCLUDING\\b|\\bUNLESS\\b"
    },
    {
      "id": "permission",
      "label": "prior permission or notification",
      "pattern": "\\bPPR\\b|\\bPRIOR\\s+(?:PERMISSION|NOTIFICATION|APPROVAL|NOTICE)\\b|\\bSUBJ(?:ECT)?\\s+TO\\b|(?<!\\bBE\\s)(?<!\\bBEEN\\s)(?<!\\bIS\\s)(?<!\\bARE\\s)(?<!\\bWAS\\s)(?<!\\bWERE\\s)\\bPROVIDED\\b"
    },
    {
      "id": "operator",
      "label": "operator or schedule condition",
      "pattern": "\\bNON[- ]?SKED\\b|\\bSKED\\b|\\bGEN(?:ERAL)?\\s+AVIATION\\b|\\bCARGO\\b(?!\\s+(?:APRON|APN|TERMINALS?|AREA|COMPLEX|BUILDING|SHED|ZONE|STANDS?)\\b)|\\bMIL(?:ITARY)?\\b"
    },
    {
      "id": "other_dimension",
      "label": "another aircraft dimension or mass",
      "pattern": "\\bTAIL\\s+(?:HGT|HEIGHT)\\b|\\bMTOW\\b|\\bMAX\\s+(?:TKOF\\s+)?(?:WEIGHT|MASS)\\b|\\bWHEEL\\s*(?:BASE|SPAN)\\b|\\bOMGWS\\b"
    },
    {
      "id": "visibility",
      "label": "visibility condition",
      "pattern": "\\bRVR\\b|\\bLVP\\b|\\bLOW\\s+VIS\\w*\\b"
    },
    {
      "id": "conditional",
      "label": "stated condition",
      "pattern": "\\bWHEN\\b|\\bIF\\b"
    },
    {
      "id": "exemption",
      "label": "stated exemption, exclusion or waiver",
      "pattern": "\\bEXEMPT(?:S|ED|ION|IONS)?\\b|\\bWAIVE[DR]?S?\\b|\\bDISPENSATIONS?\\b|\\bEXCLUDED\\b|\\bEXCLUSIONS?\\b"
    },
    {
      "id": "applicability",
      "label": "statement about what the limit applies to",
      "pattern": "\\bAPPL(?:Y|IES|IED|YING|ICABLE|ICABILITY)\\b|\\bN/A\\b"
    },
    {
      "id": "approval",
      "label": "stated permission or approval",
      "pattern": "\\b(?:ALLOWED|PERMITTED|AUTHORI[SZ]ED|APPROVED|ACCEPTED)\\b"
    },
    {
      "id": "reversal",
      "label": "cancellation, lifting or suspension stated in the notice",
      "pattern": "\\b(?:CANCELLED|CANCELED|CNL|CNLD|WITHDRAWN|REVOKED|RESCINDED|LIFTED|REMOVED|SUSPENDED|NO\\s+LONGER|RESTORED|RETURNED\\s+TO\\s+NORMAL)\\b"
    },
    {
      "id": "propulsion",
      "label": "propulsion or power condition",
      "pattern": "\\bPROPELLER\\b|\\bTURBOPROP\\b|\\bTAX\\s+PWR\\b|\\bOWN\\s+POWER\\b|\\bIDLE\\s+(?:PWR|POWER|THRUST)\\b"
    }
  ],
  "qualifierContext": {
    "negation": "\\b(?:NOT|NO|NEVER|NIL|WITHOUT|NEITHER|NOR)\\b",
    "negationLabel": "a negation that may qualify the limit",
    "clauseBoundary": "(?:[;\\n]|(?<!\\d)\\.(?!\\d)|\\s-\\s)",
    "excused": [
      {
        "markerId": "reversal",
        "label": "a named aerodrome feature is the subject of the passive reversal",
        "pattern": "\\b(?:MARKINGS?|MARKERS?|MKRS?|SIGNS?|SIGNAGE|LGTS?|LIGHTS?|LIGHTING|STRIPES?|BOARDS?|CONES?|BARRIERS?|BARRICADES?|FENC(?:E|ES|ING))(?:\\s+(?:THE|A|AN|OF|IN|ON|AT|TO|INTO|ONTO|FOR|FROM|WITHIN|WI|ALONG|ACROSS|BEHIND|BESIDE|NEAR|ADJACENT|LEADING|CLSD|CLOSED|SECTION|PART|PORTION|AREA|EDGE|CENTRE|CENTER|CL|TXL|TWY|TAXILANE|TAXIWAY|STAND|STANDS|APRON|APN|RWY|RUNWAY|GND|GROUND|TEMPO|TEMPORARY|EXISTING|[A-Z]{0,3}\\d{1,4}[A-Z]?)\\b){0,12}\\s+(?:(?:WILL|SHALL)\\s+BE|IS|ARE|BEING|BEEN|WAS|WERE|HAS\\s+BEEN|HAVE\\s+BEEN)\\s+((?:CANCELLED|CANCELED|CNL|CNLD|WITHDRAWN|REVOKED|RESCINDED|LIFTED|REMOVED|SUSPENDED|RESTORED))\\b"
      },
      {
        "markerId": "conditional",
        "label": "WHEN directly inside an advisory to pilots or crews",
        "pattern": "\\b(?:PILOTS?|CREWS?)\\s+(?:(?:ARE|IS|SHALL|SHOULD|MUST)\\s+)?(?:TO\\s+)?(?:PAY\\s+(?:EXTRA\\s+)?(?:ATTN|ATTENTION)|EXERCISE\\s+(?:EXTRA\\s+)?CAUTION|(?:MAINTAIN|KEEP)\\s+(?:A\\s+)?(?:GOOD\\s+|SHARP\\s+)?LOOKOUT)(?:\\s+(?:TO|THE|ATC|GND|GROUND|TWR|TOWER|INSTRUCTIONS?|INSTR|CLEARANCES?|MARSHALLERS?|MARSHALLING|SIGNALS?|AT|ALL|TIMES)\\b){0,6}\\s+(WHEN)\\b"
      }
    ],
    "limitVocabulary": "\\b(?:(?:ACFT|AIRCRAFT|AEROPLANES?|AIRPLANES?)|CODE|(?:WINGSPAN|WING\\s+SPAN)|LIMIT(?:S|ED|ATION|ATIONS)?|LTD|RESTRICT(?:ED|ION|IONS)?|RESTR|DOWNGRAD(?:E|ED|ING)|NOTAM|[AB]\\d{3}(?:-\\d{1,4})?|MD-?\\d{2})\\b"
  }
}
