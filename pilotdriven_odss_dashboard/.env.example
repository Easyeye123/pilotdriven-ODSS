ODSS_ENV=development

# Bounded ODSS work state. PilotDriven remains the durable commercial store.
ODSS_DATA_DIR=/var/lib/pilotdriven-odss

# Service-to-service authentication used by PilotDriven and the Playwright worker.
ODSS_SERVICE_TOKEN=replace-with-a-long-random-token

# Optional legacy single-user dashboard Basic Auth.
ODSS_USERNAME=
ODSS_PASSWORD=
# The legacy dashboard is disabled whenever the authenticated service API is
# configured unless this explicit compatibility switch is true. It remains in
# its own fixed tenant and must never share PilotDriven service records.
ODSS_ENABLE_LEGACY_DASHBOARD=false
ODSS_LEGACY_DASHBOARD_TENANT_ID=personal-dashboard

# Private controlled A350 indexes. Generate these from the authorised operator
# documents and mount them from PilotDriven-controlled storage. Do not commit
# the proprietary manuals or complete indexes to this repository.
ODSS_CDL_INDEX_PATH=/var/lib/pilotdriven-odss/references/a350_cdl_index_2026-05-05.json
# Local development uses the private file path. Production uses the tenant-
# private S3 URI instead; configure only one profile-index source.
ODSS_DEPRESS_PROFILE_INDEX_PATH=/var/lib/pilotdriven-odss/references/a350_depress_profiles_index_2026-06-12.json
# ODSS_DEPRESS_PROFILE_INDEX_S3_URI=s3://private-bucket/registry/tenants/example/controlled-indexes/depressurisation/current.json
# ODSS_TENANT_ID=example

# Private, tenant-scoped Level 3 policy indexes. Prefer the directory form so
# each tenant resolves only its own "<tenant-id>.json" catalogue. A configured
# single path is accepted only when its embedded tenant_id matches the request.
# No path means no approved policy: Level 3 remains PARTIAL / review required.
# Never point this at sample or regression data in production.
ODSS_LEVEL3_POLICY_INDEX_DIR=/var/lib/pilotdriven-odss/level3-policies
ODSS_LEVEL3_POLICY_INDEX_PATH=

# Product policy windows. Destination/alternate defaults to ETA +/- 2 hours.
ODSS_NOTAM_DEPARTURE_WINDOW_MINUTES=60
ODSS_NOTAM_ARRIVAL_WINDOW_MINUTES=120

# Official public NOAA/AWC international SIGMET source. Positive volcanic-ash
# intersections are authoritative; incomplete future coverage fails closed to
# review-required rather than being presented as "no volcanic ash".
ODSS_VA_SIGMET_SOURCE=awc
ODSS_SIGMET_SOURCE=awc
ODSS_VA_SIGMET_URL=https://aviationweather.gov/api/data/isigmet?format=json
ODSS_VA_SIGMET_TIMEOUT_SECONDS=8
ODSS_VA_SIGMET_FRESHNESS_MINUTES=15
ODSS_VA_SIGMET_CACHE_SECONDS=60
ODSS_VA_SIGMET_USER_AGENT=PilotDriven-ODSS/0.6.1 (operational-briefing service)

# ODSS v0.6 realistic map configuration.
ODSS_MAP_PROVIDER=aws-location
AWS_REGION=ap-southeast-2
# Public browser key restricted to approved website referrers and map actions.
AWS_LOCATION_API_KEY=
# Optional server-only key for static-map fallback. If blank, the browser key
# is reused for backwards compatibility and must also permit server requests.
AWS_LOCATION_SERVER_API_KEY=
ODSS_MAP_STYLE=Hybrid
ODSS_MAP_LANGUAGE=en
ODSS_MAP_FALLBACK=static
ODSS_MAP_SCREENSHOT_TIMEOUT_SECONDS=30
ODSS_MAP_PRINT_BASE_URL=http://127.0.0.1:8000
